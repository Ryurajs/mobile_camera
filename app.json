{
  "expo": {
    "name": "Camera Link",
    "slug": "camera-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Camera Link to use the camera when you choose to share it.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Camera Link to share video after you accept a request.",
          "microphonePermission": "Camera Link does not record audio."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-dontwarn org.webrtc.Dav1dDecoder$Natives"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cameralink.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "559a8dc8-85b2-435d-8652-2fa31681703a"
      }
    }
  }
}
